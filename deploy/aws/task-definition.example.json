{
  "family": "gyproject-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {"cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX"},
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/gyprojectExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/gyprojectTaskRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/gyproject-backend:IMAGE_TAG",
      "essential": true,
      "user": "10001:10001",
      "portMappings": [{"containerPort": 8000, "protocol": "tcp", "appProtocol": "http"}],
      "stopTimeout": 90,
      "linuxParameters": {"initProcessEnabled": true},
      "environment": [
        {"name": "DJANGO_DEBUG", "value": "false"},
        {"name": "DJANGO_ALLOWED_HOSTS", "value": "api.example.com"},
        {"name": "CORS_ALLOWED_ORIGINS", "value": "https://frontend.example.com,https://api.example.com"},
        {"name": "DJANGO_TRUST_PROXY_HEADERS", "value": "true"},
        {"name": "DJANGO_HTTP_HEALTHCHECK", "value": "true"},
        {"name": "DJANGO_CACHE_TABLE", "value": "gyproject_cache"},
        {"name": "POSTGRES_HOST", "value": "RDS_ENDPOINT"},
        {"name": "POSTGRES_PORT", "value": "5432"},
        {"name": "POSTGRES_DB", "value": "gyproject"},
        {"name": "POSTGRES_USER", "value": "gyproject_app"},
        {"name": "POSTGRES_SSLMODE", "value": "require"},
        {"name": "WEB_CONCURRENCY", "value": "2"}
      ],
      "secrets": [
        {"name": "DJANGO_SECRET_KEY", "valueFrom": "APP_SECRET_ARN:DJANGO_SECRET_KEY::"},
        {"name": "POSTGRES_PASSWORD", "valueFrom": "APP_SECRET_ARN:POSTGRES_PASSWORD::"}
      ],
      "healthCheck": {
        "command": ["CMD", "python", "docker/healthcheck.py"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/gyproject-backend",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs",
          "mode": "non-blocking",
          "max-buffer-size": "10m"
        }
      }
    }
  ]
}
