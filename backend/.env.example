DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate your own random secret.
DJANGO_SECRET_KEY=
# Render adds RENDER_EXTERNAL_HOSTNAME automatically; include custom domains here.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://gy-project-frontend.onrender.com,http://localhost:5173,http://127.0.0.1:5173
# In the Render BACKEND web service, set DATABASE_URL to the existing PostgreSQL
# service's Internal Database URL. Creating a database alone does not set this.
# Set DJANGO_DEBUG=false and a stable DJANGO_SECRET_KEY on Render.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Set these instead to use PostgreSQL locally without DATABASE_URL.
# POSTGRES_DB=ganesh_audit
# POSTGRES_USER=ganesh
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional SMTP settings. Use a Gmail App Password, not your normal password.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=your-address@gmail.com

# AWS: enable only behind a trusted proxy that sets X-Forwarded-Proto.
# DJANGO_TRUST_PROXY_HEADERS=true
# Enable only when your load balancer checks /health/ using HTTP.
# DJANGO_HTTP_HEALTHCHECK=true
# Optional shared throttle cache; run manage.py createcachetable before serving.
# DJANGO_CACHE_TABLE=gyproject_cache
# Split POSTGRES_* settings default to require in production, disable in DEBUG.
# POSTGRES_SSLMODE=require
