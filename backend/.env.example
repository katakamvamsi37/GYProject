DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate your own random secret.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Render provides this automatically when the PostgreSQL database is linked.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Set these instead to use PostgreSQL locally without DATABASE_URL.
# POSTGRES_DB=ganesh_audit
# POSTGRES_USER=ganesh
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
